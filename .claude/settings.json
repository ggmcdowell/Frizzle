{
  "instructionFiles": "claude-md-or-agents-md",
  "autoMemoryEnabled": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "idleCompaction": false,
  "crossSessionInbound": "accept",
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/Drawer/statusline-command.sh\"",
    "refreshInterval": 15
  },
  "model": "opus",
  "effortLevel": "medium",
  "verbose": false,
  "outputStyle": "STE-100",
  "awaySummaryEnabled": false,
  "enableArtifact": false,
  "promptSuggestionEnabled": false,
  "showClearContextOnPlanAccept": true,
  "switchModelsOnFlag": false,
  "permissions": {
    "deny": [
      "Agent",
      "mcp__ccd_turn"
    ]
  },
  "skillOverrides": {
    "claude-api": "name-only",
    "code-review": "name-only",
    "dataviz": "name-only",
    "fewer-permission-prompts": "name-only",
    "init": "name-only",
    "keybindings-help": "name-only",
    "loop": "name-only",
    "plugin-authoring": "name-only",
    "run": "name-only",
    "schedule": "name-only",
    "security-review": "name-only",
    "simplify": "name-only",
    "update-config": "name-only"
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_SUBAGENT_EFFORT": "medium",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "CLAUDE_CODE_SEND_FEEDBACK": "0",
    "MCP_TIMEOUT": "60000",
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "enabledMcpjsonServers": [
    "mem"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Write$|^Edit$|^MultiEdit$|^NotebookEdit$|^Agent$|^Workflow$|^Bash$|^Monitor$|^(mcp__mem__)?add$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/Drawer/hooks/run-hook.sh\" gate \"$CLAUDE_PROJECT_DIR/Drawer/project-gate.py\"",
            "timeout": 180
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/Drawer/hooks/run-hook.sh\" pass \"$CLAUDE_PROJECT_DIR/Drawer/seat-note.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/Drawer/hooks/run-hook.sh\" pass \"$CLAUDE_PROJECT_DIR/Drawer/pad-guard.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/Drawer/hooks/run-hook.sh\" boot \"$CLAUDE_PROJECT_DIR/Drawer/hooks/session-start.py\"",
            "timeout": 240
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "{ [ -z \"${FRIZZLE_FLIGHT:-}\" ] && [ ! -d \"$CLAUDE_PROJECT_DIR/Flight/seats\" ]; } || sh \"$CLAUDE_PROJECT_DIR/Drawer/hooks/run-hook.sh\" pass \"$CLAUDE_PROJECT_DIR/Drawer/flight-hooks.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{ [ -z \"${FRIZZLE_FLIGHT:-}\" ] && [ ! -d \"$CLAUDE_PROJECT_DIR/Flight/seats\" ]; } || sh \"$CLAUDE_PROJECT_DIR/Drawer/hooks/run-hook.sh\" pass \"$CLAUDE_PROJECT_DIR/Drawer/flight-hooks.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{ [ -z \"${FRIZZLE_FLIGHT:-}\" ] && [ ! -d \"$CLAUDE_PROJECT_DIR/Flight/seats\" ]; } || sh \"$CLAUDE_PROJECT_DIR/Drawer/hooks/run-hook.sh\" pass \"$CLAUDE_PROJECT_DIR/Drawer/flight-hooks.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/Drawer/hooks/run-hook.sh\" pass \"$CLAUDE_PROJECT_DIR/Drawer/git-branch-policy.py\" own-cleanup --session-end",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{ [ -z \"${FRIZZLE_FLIGHT:-}\" ] && [ ! -d \"$CLAUDE_PROJECT_DIR/Flight/seats\" ]; } || sh \"$CLAUDE_PROJECT_DIR/Drawer/hooks/run-hook.sh\" pass \"$CLAUDE_PROJECT_DIR/Drawer/flight-hooks.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/Drawer/hooks/run-hook.sh\" pass \"$CLAUDE_PROJECT_DIR/Drawer/context-nudge.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
