#!/bin/sh
# Tracked product-repo hook, reached through the clone's core.hooksPath (PRODUCT-CONVENTIONS.md PRD-2).
# Git runs hooks only from that path, so this chains to the repo's tracked .githooks/pre-commit, when it has one.
repo=$(git rev-parse --show-toplevel) || exit 0
hub=$(cd "$(dirname "$0")/../.." && pwd -P) || exit 0
# The hub environment holds the pinned product tools (gdformat): put it first on PATH for the repo hook.
# Its folder is .venv/Scripts on Windows; a folder that does not exist on PATH is harmless.
PATH="$hub/.venv/bin:$hub/.venv/Scripts:$PATH"
export PATH
hook="$repo/.githooks/pre-commit"
if test -f "$hook"; then
  . "$(dirname "$0")/dispatch.sh"
  run_product_hook "$hub" "$hook" "$@"
fi
exit 0
